# ---------------------------------------------------------------
# PUBLIC (bundled into the browser). Firebase web config is an
# identifier, not a secret; access is enforced by Firestore rules
# and App Check. Copy to .env.local for local dev and set the same
# variables in Netlify > Site configuration > Environment variables.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sriram-kannan.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sriram-kannan
VITE_FIREBASE_STORAGE_BUCKET=sriram-kannan.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA site key registered for App Check (public by design)
# true when registered under "Fraud Defense (reCAPTCHA Enterprise)", empty for classic reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_ENTERPRISE=
# Comma-separated Firebase Auth UIDs allowed into /admin (UIDs are not secrets)
VITE_ADMIN_UIDS=

# ---------------------------------------------------------------
# SERVER ONLY: used inside netlify/functions. Never prefix with VITE_.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=sriram-kannan
ADMIN_UIDS=
GEMINI_API_KEY=
# Optional; falls back to gemini-flash-latest, then gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-latest
# Google Apps Script web-app URL that sends email ({to, subject, body, senderName})
SEND_EMAIL_URL=
# Google Apps Script web-app URL that appends rows to the sheet ({data: [...]})
SHEETS_SYNC_URL=
# Link shown as "View spreadsheet" (returned by the function, not bundled)
SHEETS_VIEW_URL=
